# config/database.yml resolves every environment's database from the same
# POSTGRES_DATABASE variable, so a .env that names the development database
# (as the local setup does) makes `bundle exec rspec` run — and truncate —
# against development data. Dotenv loads this file ahead of .env in the test
# environment, and never overrides a real environment variable, so CI keeps
# whatever it exports.
POSTGRES_DATABASE=chatwoot_test
